# Python — one shared env at the repo root, created by `uv sync`.
# uv.lock is committed on purpose; it is what makes the install reproducible.
.venv
__pycache__
.pytest_cache
.ruff_cache

# Personal lefthook overrides; lefthook.yml itself is committed
lefthook-local.yml

# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Editors — share the interpreter path, keep personal state out
.vscode/*
!.vscode/settings.json
.fleet
.idea

# Misc
.DS_Store

# Local env files
.env
.env.*
!.env.example
