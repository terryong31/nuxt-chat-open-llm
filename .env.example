# Master Environment Configuration Template
# Select environment by setting APP_ENV or using mode-specific .env files (.env.development, .env.staging, .env.production)

APP_ENV=development # development | staging | production

# Supabase Credentials (Cloud project per environment)
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_KEY=your-dev-anon-key

# Frontend -> Backend LLM Server URL
NUXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Backend Server Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=DEBUG
