# Master environment template for the Python halves.
#
# Copy to server/api/.env.development (or .env.staging / .env.production) and
# fill in. APP_ENV selects which of those files is read; it is the one variable
# here that is NOT prefixed.
#
# Every other setting is LLM_-prefixed because both services set
# env_prefix="LLM_". Unprefixed names are ignored silently — a gateway started
# with SUPABASE_URL set has no Supabase credentials at all.
#
# The frontend has its own template: apps/web/.env.example

APP_ENV=development # development | staging | production

# -- Gateway: server/api, :8000 -----------------------------------------------
LLM_HOST=127.0.0.1
LLM_PORT=8000
LLM_LOG_LEVEL=INFO

# Where the inference engine listens. The doubled prefix is correct: the
# setting is `llm_engine_url` and the prefix is LLM_.
LLM_LLM_ENGINE_URL=http://127.0.0.1:9000

# Tokens requested per reply. The engine's own default is 200, which cuts a
# code answer off mid-block. Must stay under the engine's LLM_MAX_TOKENS_LIMIT.
LLM_MAX_TOKENS=1024

# Origins allowed to call the gateway from a browser. The SPA's origin must be
# listed or every chat fails with nothing in the server log.
LLM_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# -- Supabase (one project per environment) -----------------------------------
# The service-role key bypasses RLS and must never reach the browser.
LLM_SUPABASE_URL=https://your-dev-project.supabase.co
LLM_SUPABASE_SERVICE_KEY=your-service-role-key
LLM_SUPABASE_JWT_SECRET=your-jwt-secret

# -- Engine: server/llm, :9000 ------------------------------------------------
# Put these in server/llm/.env.<APP_ENV>. Both halves read the same LLM_
# prefix, so separate files are what keeps HOST/PORT from colliding.
# LLM_MODEL_ID=mlx-community/Mamba-Codestral-7B-v0.1-4bit
# LLM_PORT=9000
# LLM_API_KEYS=[]            # JSON list; empty disables auth
# LLM_DEFAULT_MAX_TOKENS=200 # raise for longer replies
